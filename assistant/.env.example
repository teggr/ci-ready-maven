# Documentation only: Spring Boot does not automatically load this file.
# Export variables explicitly or inject them with your container/deployment.
ASSISTANT_ENABLED=false
ASSISTANT_CHAT_PROVIDER=none
# To enable after evaluation: ASSISTANT_CHAT_PROVIDER=openai
ASSISTANT_API_BASE_URL=https://ollama.com/v1
ASSISTANT_API_KEY=replace-with-provider-key
# Choose from the authenticated provider model list; no production default approved.
ASSISTANT_MODEL=replace-with-evaluated-model
SERVER_PORT=8080
# Deploy4j configuration inputs:
ASSISTANT_HOST=assistant.example.com
ASSISTANT_VPS=203.0.113.10
ASSISTANT_IMAGE=your-registry-user/ci-ready-maven-assistant
ACME_EMAIL=operations@example.com
DEPLOY_SSH_KEY=/home/deployer/.ssh/id_ed25519
DEPLOY_KNOWN_HOSTS=/home/deployer/.ssh/known_hosts
DOCKER_USERNAME=replace-with-registry-user
DOCKER_PASSWORD=replace-with-registry-token
